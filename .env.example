# Rara AI - Multi Device — Environment Variables Example
# Copy file ini ke .env dan isi nilai sebenarnya
# Tapi di v21.4.0, API keys sudah pakai src/lib/apikey/*.json (lebih aman)

# Pterodactyl Panel (opsional, untuk auto-restart)
PTERO_SERVER1_DOMAIN=https://your-panel.com
PTERO_SERVER1_APIKEY=ptla_xxxxx
PTERO_SERVER1_CAPIKEY=ptla_xxxxx

# Bot Settings
BOT_NAME=Rara AI
BOT_VERSION=21.4.0
