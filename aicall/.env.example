# ==============================================================================
#                 WHATSAPP AI CALL ASSISTANT BOT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI CONFIGURATION (Wajib)
# ------------------------------------------------------------------------------
# API Key Google Gemini (Gratis)
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API=your_gemini_api_key_here

# Model AI Gemini Percakapan
# Opsi: gemini-3.1-flash-lite (Default ~0.3s, Bebas Kuota), gemini-3.6-flash, gemini-3.5-flash
GEMINI_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# 2. GROQ SPEECH-TO-TEXT (STT) CONFIGURATION (Wajib)
# ------------------------------------------------------------------------------
# API Key Groq (Gratis) untuk Transkripsi Suara Whisper Large v3
# Dapatkan di: https://console.groq.com/keys
GROQ_API=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 3. TEXT-TO-SPEECH (TTS) ENGINE SELECTION
# ------------------------------------------------------------------------------
# Pilihan Engine TTS: edgetts / geminitts / elevenlabs / openai / animetts / google
# - edgetts    : 100% GRATIS SELAMANYA, Suara Manusia Microsoft Azure Neural
# - geminitts  : 100% GRATIS, Suara Bawaan Google Gemini Audio (Puck, Kore, Aoede)
# - elevenlabs : Suara manusia paling realistis & beremosi (Gratis 10k karakter/bln)
# - openai     : Suara OpenAI Audio (Berbayar / Credit Balance)
# - animetts   : Suara Karakter Anime (140+ Karakter Umamusume, Genshin, dll)
# - google     : Fallback Google Translate TTS
TTS_ENGINE=edgetts

# ------------------------------------------------------------------------------
# 4. SUARA & NADA TTS (TTS VOICE & PITCH CONFIGURATION)
# ------------------------------------------------------------------------------
# Pilihan Suara (Disesuaikan dengan TTS_ENGINE):
# - Jika TTS_ENGINE=edgetts   : ms-MY-YasminNeural (Wanita Manis), id-ID-ArdiNeural (Pria), id-ID-GadisNeural
# - Jika TTS_ENGINE=geminitts : Puck (Netral/Pria Hangat), Kore (Wanita Soft), Aoede (Wanita Ekspresif)
# - Jika TTS_ENGINE=openai    : nova, shimmer, alloy, echo, onyx, fable, ash, coral, sage
TTS_VOICE=ms-MY-YasminNeural

# Tinggi / Rendah Pitch Nada Suara (Khusus edgetts)
# Menurunkan pitch (misal: -2Hz atau -1Hz) membuat suara lebih santai, hangat & alami
TTS_PITCH=-1Hz

# Kecepatan Suara TTS (Default: 1.0, Contoh: 1.2 untuk lebih cepat, 0.8 lebih lambat)
TTS_SPEED=1.0

# ------------------------------------------------------------------------------
# 5. ELEVENLABS & OPENAI API KEYS (Opsional)
# ------------------------------------------------------------------------------
# ElevenLabs API Key & Voice ID (Jika TTS_ENGINE=elevenlabs)
# Dapatkan di: https://elevenlabs.io
ELEVENLABS_API=your_elevenlabs_api_key_here
ELEVEN_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# OpenAI API Key (Jika TTS_ENGINE=openai)
# Dapatkan di: https://platform.openai.com/api-keys
OPENAI_API=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 6. ANIME TTS CONFIGURATION (Opsional - Jika TTS_ENGINE=animetts)
# ------------------------------------------------------------------------------
# Nama Karakter Lengkap (Lihat katalog di VOICE_MODELS.md)
TTS_CHARACTER=特别周 Special Week (Umamusume Pretty Derby)

# Pilihan Bahasa Anime TTS: Mix / English / 日本語 / 简体中文
TTS_LANG=Mix
PROMPT_LANG=id

# ------------------------------------------------------------------------------
# 7. FITUR OWNER / PENGAMAN BOT (BOT SECURITY)
# ------------------------------------------------------------------------------
# Nomor HP Owner yang diizinkan mengakses bot / menelpon (Dipisahkan koma jika lebih dari 1)
# Kosongkan jika ingin bot bisa diakses publik oleh siapa saja.
# Contoh: OWNER=628123456789,628987654321
OWNER=628123456789

# ------------------------------------------------------------------------------
# 8. CUSTOM SYSTEM PROMPT AI PERCAKAPAN
# ------------------------------------------------------------------------------
# Gaya dan instruksi bicara AI dalam panggilan telepon
SYSTEM_PROMPT="Kamu adalah asisten suara AI pintar yang sedang berbicara lewat panggilan telepon WhatsApp. Jawablah dengan singkat, ramah, dan alami (maksimal 2-3 kalimat). JANGAN gunakan format markdown (*, #, -, tabel)."

# ------------------------------------------------------------------------------
# 9. INTEGRASI NOVA BOT (17 Sep 2026) — plugin .aicall di bot utama
# ------------------------------------------------------------------------------
# Nomor HP owner (62...) → login pakai 8-digit PAIRING CODE (gak perlu QR, cocok VPS).
# Buka WhatsApp HP -> Setelan -> Perangkat Tertaut -> Tautkan Perangkat ->
# Tautkan dgn Nomor Telepon -> masukkan kode yang muncul di log service ini.
# Kosongkan jika ingin login via QR.
PAIR_PHONE=

# Port API lokal — dipakai plugin .aicall bot utama (BIND 127.0.0.1 SAJA, gak ke luar)
AICALL_HTTP_PORT=8788

# (Opsional tapi disarankan) Token API lokal — kalau diisi, HARUS sama dengan
# env AICALL_HTTP_KEY di bot utama (pm2/ecosystem).
AICALL_HTTP_KEY=

# Chat command service ini (default false = MATI biar gak dobalas .menu/.status
# dengan bot utama — semua akses lewat plugin .aicall). Set "true" jika jalan standalone.
COMMANDS_ENABLED=false
