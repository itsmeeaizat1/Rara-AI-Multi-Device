{
    "_comment": "NOVA AI WHATSAPP BOT - Pterodactyl Egg v2 (Baileys Multi-Device Optimized)",
    "meta": {
        "version": "PTDL_v2",
        "update_url": null
    },
    "exported_at": "2026-08-16T21:55:00+07:00",
    "name": "Nova AI WhatsApp Bot v2",
    "author": "Aizat",
    "description": "WhatsApp Bot Baileys Multi-Device - Node.js. Support auto-restart, session persistence, dan plugin modular. Compatible Node.js 20-22.",
    "features": null,
    "docker_images": {
        "Node 20": "ghcr.io/parkervcp/yolks:node_20",
        "Node 22": "ghcr.io/parkervcp/yolks:node_22"
    },
    "file_denylist": [],
    "startup": "if [ \"$AUTO_RESTART\" = \"1\" ]; then while true; do node index.js; echo \"[Nova] Bot crashed, restarting in 3s...\"; sleep 3; done; else node index.js; fi",
    "config": {
        "files": "{\n    \"config.js\": {\n        \"parser\": \"javascript\",\n        \"find\": {\n            \"botName\": \"Nova AI Bot\",\n            \"ownerNumber\": \"\"\n        }\n    }\n}",
        "startup": "{\n    \"done\": [\n        \"Nova AI Bot Connected\",\n        \"Connection: open\",\n        \"Connection open\",\n        \"opened connection\",\n        \"Credentials updated\",\n        \"Bot is ready\",\n        \"Store: open\"\n    ]\n}",
        "logs": "{\n    \"custom\": false,\n    \"location\": \"logs/latest.log\"\n}",
        "stop": "^C"
    },
    "scripts": {
        "installation": {
            "script": "#!/bin/ash\necho \"=== Nova AI WhatsApp Bot v2 Installer ===\"\necho \"\"\ncd /mnt/server\nmkdir -p session database assets logs plugins config\necho \"[*] Directories created\"\nif [ ! -f \"package.json\" ]; then\n    echo \"[!] package.json not found. Upload bot files first then reinstall.\"\n    exit 1\nfi\nif [ -d \"node_modules\" ]; then\n    echo \"[*] node_modules detected, verifying...\"\n    npm install --production 2>&1 || npm install 2>&1\nelse\n    echo \"[*] Installing npm dependencies...\"\n    npm install 2>&1\nfi\nif [ -d \"node_modules/@whiskeysockets\" ] || [ -d \"node_modules/@adiwajshing\" ]; then\n    echo \"[*] Baileys detected\"\nelse\n    echo \"[!] Baileys not found, installing...\"\n    npm install @whiskeysockets/baileys 2>&1 || echo \"[!] Manual install needed\"\nfi\necho \"\"\necho \"=== Installation Complete ===\"",
            "container": "ghcr.io/parkervcp/installers:alpine",
            "entrypoint": "ash"
        }
    },
