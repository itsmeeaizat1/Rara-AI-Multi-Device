    "scripts": {
        "installation": {
            "script": "#!\/bin\/ash\n# Nova AI WhatsApp Bot Installation Script\n\necho \"=== Installing Nova AI WhatsApp Bot ===\"\n\ncd \/mnt\/server\n\n# Check if package.json exists\nif [ ! -f \"package.json\" ]; then\n    echo \"ERROR: package.json not found!\"\n    echo \"Please upload your bot files first.\"\n    exit 1\nfi\n\n# Install npm dependencies\necho \"Installing npm dependencies...\"\nnpm install --production 2>&1\n\n# Create required directories\nmkdir -p session database assets logs plugins\/future\n\necho \"=== Installation Complete ===\necho \"Starting Nova AI WhatsApp Bot...\"",
            "container": "ghcr.io\/parkervcp\/installers:alpine",
            "entrypoint": "ash"
        }
    },
